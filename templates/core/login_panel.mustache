{{!
    @template core/login_panel

    E-Horizon override of the left panel of the split-screen login.
    If the site defines custom auth instructions (leftinstructions) they win.

    Example context (json):
    {
        "leftinstructions": ""
    }
}}
<div class="login-layout-left-content">
    {{^leftinstructions}}
        <p class="eh-login-eyebrow">{{#str}}loginpanel_eyebrow, theme_ehorizon{{/str}}</p>
        <h1 class="eh-login-title">{{#str}}loginpanel_title, theme_ehorizon{{/str}}</h1>
        <p class="eh-login-lead">{{#str}}loginpanel_lead, theme_ehorizon{{/str}}</p>
        <ul class="eh-login-steps">
            <li><strong>{{#str}}loginpanel_step1, theme_ehorizon{{/str}}</strong><span>{{#str}}loginpanel_step1_desc, theme_ehorizon{{/str}}</span></li>
            <li><strong>{{#str}}loginpanel_step2, theme_ehorizon{{/str}}</strong><span>{{#str}}loginpanel_step2_desc, theme_ehorizon{{/str}}</span></li>
            <li><strong>{{#str}}loginpanel_step3, theme_ehorizon{{/str}}</strong><span>{{#str}}loginpanel_step3_desc, theme_ehorizon{{/str}}</span></li>
        </ul>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="mx-auto text-start">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>
